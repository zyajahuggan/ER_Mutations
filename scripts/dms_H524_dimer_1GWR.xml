<!-- DMS at H524 of holo ERα homodimer + real TIF2 coactivator peptides (1GWR): chains A+B
     protein, chains C+D estradiol, chains E+F peptide. Scores both AB_CD (protein-ligand)
     and AB_EF (protein-peptide) interfaces. -->
<ROSETTASCRIPTS>
    <SCOREFXNS>
        <ScoreFunction name="ref15" weights="ref2015"/>
    </SCOREFXNS>

    <RESIDUE_SELECTORS>
        <!-- Mutation sites on both monomers -->
        <Index name="mut_site" resnums="524A,524B"/>
        <!-- 8 Å shell around both mutation sites -->
        <Neighborhood name="shell" selector="mut_site" distance="8.0"/>
        <Not name="frozen" selector="shell"/>
        <Chain name="ligands" chains="C,D"/>
        <Chain name="peptides" chains="E,F"/>
        <True name="all"/>
    </RESIDUE_SELECTORS>

    <TASKOPERATIONS>
        <InitializeFromCommandline name="init"/>
        <IncludeCurrent name="current"/>
        <LimitAromaChi2 name="limitchi2" chi2max="110" chi2min="70" include_trp="True"/>
        <ExtraRotamersGeneric name="ex1_ex2" ex1="1" ex2="1"/>
        <!-- Freeze residues outside the shell; only repack (no design) -->
        <OperateOnResidueSubset name="norepack" selector="frozen">
            <PreventRepackingRLT/>
        </OperateOnResidueSubset>
        <OperateOnResidueSubset name="restrict2repacking" selector="all">
            <RestrictToRepackingRLT/>
        </OperateOnResidueSubset>
    </TASKOPERATIONS>

    <MOVERS>
        <FastRelax name="FastRelax" scorefxn="ref15"
            cartesian="false" bondangle="false" bondlength="false"
            min_type="dfpmin_armijo_nonmonotone"
            task_operations="init,current,ex1_ex2,limitchi2,norepack,restrict2repacking"
            relaxscript="InterfaceDesign2019"
            repeats="5">
            <MoveMap name="MM">
                <Chain number="1" chi="true" bb="false"/>  <!-- chain A protein -->
                <Chain number="2" chi="true" bb="false"/>  <!-- chain B protein -->
                <Chain number="3" chi="true" bb="false"/>  <!-- chain C estradiol (monomer 1) -->
                <Chain number="4" chi="true" bb="false"/>  <!-- chain D estradiol (monomer 2) -->
                <Chain number="5" chi="true" bb="false"/>  <!-- chain E TIF2 peptide (monomer 1) -->
                <Chain number="6" chi="true" bb="false"/>  <!-- chain F TIF2 peptide (monomer 2) -->
                <Jump number="1" setting="true"/>           <!-- rigid-body A-B dimer -->
                <Jump number="2" setting="true"/>           <!-- rigid-body protein-EST C -->
                <Jump number="3" setting="true"/>           <!-- rigid-body EST C-D -->
                <Jump number="4" setting="true"/>           <!-- rigid-body protein-peptide E -->
                <Jump number="5" setting="true"/>           <!-- rigid-body peptide E-F -->
                <!-- Shell residues on both chains get full backbone + chi freedom -->
                <ResidueSelector selector="shell" chi="true" bb="true"/>
            </MoveMap>
        </FastRelax>

        <!-- Measure how mutations affect combined protein-ligand binding (dimer vs both ESTs) -->
        <InterfaceAnalyzerMover name="analyze_interface_ligand"
            scorefxn="ref15"
            interface="AB_CD"
            pack_separated="1"
            packstat="true"/>

        <!-- Measure how mutations affect combined coactivator peptide recruitment -->
        <InterfaceAnalyzerMover name="analyze_interface_peptide"
            scorefxn="ref15"
            interface="AB_EF"
            pack_separated="1"
            packstat="true"/>
    </MOVERS>

    <APPLY_TO_POSE/>

    <PROTOCOLS/>

    <OUTPUT scorefxn="ref15"/>
</ROSETTASCRIPTS>
