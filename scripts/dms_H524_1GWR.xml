<!-- DMS at H524 of holo ERα monomer + real TIF2 coactivator peptide (1GWR): chain A protein,
     chain B estradiol, chain C peptide. Scores both the A_B (protein-ligand) and A_C
     (protein-peptide) interfaces so mutation effects on ligand binding and coactivator
     recruitment can be compared side by side. -->
<ROSETTASCRIPTS>
    <SCOREFXNS>
        <ScoreFunction name="ref15" weights="ref2015"/>
    </SCOREFXNS>

    <RESIDUE_SELECTORS>
        <Index name="mut_site" resnums="524A"/>
        <!-- 8 Å shell around the mutation site -->
        <Neighborhood name="shell" selector="mut_site" distance="8.0"/>
        <Not name="frozen" selector="shell"/>
        <Chain name="ligand" chains="B"/>
        <Chain name="peptide" chains="C"/>
        <True name="all"/>
    </RESIDUE_SELECTORS>

    <TASKOPERATIONS>
        <InitializeFromCommandline name="init"/>
        <IncludeCurrent name="current"/>
        <LimitAromaChi2 name="limitchi2" chi2max="110" chi2min="70" include_trp="True"/>
        <ExtraRotamersGeneric name="ex1_ex2" ex1="1" ex2="1"/>
        <!-- Freeze residues outside the shell; only repack (no design) -->
        <OperateOnResidueSubset name="norepack" selector="frozen">
            <PreventRepackingRLT/>
        </OperateOnResidueSubset>
        <OperateOnResidueSubset name="restrict2repacking" selector="all">
            <RestrictToRepackingRLT/>
        </OperateOnResidueSubset>
    </TASKOPERATIONS>

    <MOVERS>
        <FastRelax name="FastRelax" scorefxn="ref15"
            cartesian="false" bondangle="false" bondlength="false"
            min_type="dfpmin_armijo_nonmonotone"
            task_operations="init,current,ex1_ex2,limitchi2,norepack,restrict2repacking"
            relaxscript="InterfaceDesign2019"
            repeats="5">
            <MoveMap name="MM">
                <Chain number="1" chi="true" bb="false"/>  <!-- chain A protein -->
                <Chain number="2" chi="true" bb="false"/>  <!-- chain B estradiol -->
                <Chain number="3" chi="true" bb="false"/>  <!-- chain C TIF2 peptide -->
                <Jump number="1" setting="true"/>           <!-- rigid-body protein-EST -->
                <Jump number="2" setting="true"/>           <!-- rigid-body protein-peptide -->
                <!-- Shell residues get full backbone + chi freedom -->
                <ResidueSelector selector="shell" chi="true" bb="true"/>
            </MoveMap>
        </FastRelax>

        <!-- Measure how mutations affect protein-ligand binding -->
        <InterfaceAnalyzerMover name="analyze_interface_ligand"
            scorefxn="ref15"
            interface="A_B"
            pack_separated="1"
            packstat="true"/>

        <!-- Measure how mutations affect coactivator peptide recruitment -->
        <InterfaceAnalyzerMover name="analyze_interface_peptide"
            scorefxn="ref15"
            interface="A_C"
            pack_separated="1"
            packstat="true"/>
    </MOVERS>

    <APPLY_TO_POSE/>

    <PROTOCOLS/>

    <OUTPUT scorefxn="ref15"/>
</ROSETTASCRIPTS>
